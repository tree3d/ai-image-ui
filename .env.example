# Required: OpenAI API key used for image generation.
OPENAI_API_KEY=sk-your-api-key-here

# Required for usage/cost stats: OpenAI Admin key (sk-admin-...).
# Create one at platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=sk-admin-your-admin-key-here

# Required for image-to-video animation via fal.ai (xai/grok-imagine-video).
# Get your key at fal.ai/dashboard/keys
FAL_KEY=your-fal-api-key-here

# Optional: image model override. Defaults to gpt-image-2 if unset.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: backend server port. Defaults to 5010 if unset.
PORT=5010

# Optional: Ollama prompt enhancer settings.
# OLLAMA_URL defaults to http://localhost:11434 if unset.
# OLLAMA_MODEL defaults to gemma4:31B if unset.
# OLLAMA_NUM_CTX sets the context window (tokens). Defaults to 8192 if unset.
# OLLAMA_SYSTEM_PROMPT overrides the built-in system prompt if set.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31B
OLLAMA_NUM_CTX=8192
OLLAMA_SYSTEM_PROMPT=
