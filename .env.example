# Required: OpenAI API key used for image generation.
OPENAI_API_KEY=sk-your-api-key-here

# Required for usage/cost stats: OpenAI Admin key (sk-admin-...).
# Create one at platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=sk-admin-your-admin-key-here

# Optional: image model override. Defaults to gpt-image-2 if unset.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: backend server port. Defaults to 5010 if unset.
PORT=5010
